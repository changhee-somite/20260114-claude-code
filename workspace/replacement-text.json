          "level": 0
        },
        {
          "text": "Alternative: CLI tools with README loaded on-demand",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Pro-MCP: Convenience of always-available tools",
          "bullet": true,
          "level": 0
        },
