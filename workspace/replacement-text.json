  "slide-25": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Granular Permission Rules",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "allow: [\"Bash(npm run test:*)\", \"Bash(git:*)\"]",
          "bullet": true,
          "level": 0
        },
        {
          "text": "deny: [\"Read(./.env)\", \"Read(**/*.key)\"]",
          "bullet": true,
          "level": 0
        },
        {
          "text": "ask: [\"Bash(git push:*)\", \"Bash(rm:*)\"]",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Evaluation order: deny \u2192 allow \u2192 ask",
          "bullet": true,
          "level": 0
        }
      ]
    }
