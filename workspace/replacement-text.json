  "slide-9": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "The Hard Context Limit",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "Attention mechanism scales quadratically O(N\u00b2)",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Context window is a hard limit on what the model can \"see\"",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Everything must fit in this window",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Wasted tokens = reduced capability",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
  "slide-10": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Context Engineering Is Fundamental",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "Minimal system prompts: <1,000 tokens vs competitors' 10,000+",
          "bullet": true,
          "level": 0
        },
        {
          "text": "File-based planning: External markdown preserves info",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Progressive disclosure: Load tool docs only when needed",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Pre-session artifacts: Research \u2192 implementation sessions",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
