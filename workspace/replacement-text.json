        {
          "text": "Four Permission Modes",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "default: Prompts for first use of each tool",
          "bullet": true,
          "level": 0
        },
        {
          "text": "acceptEdits: Auto-accepts file edits for session",
          "bullet": true,
          "level": 0
        },
        {
          "text": "plan: Read-only analysis, no modifications",
          "bullet": true,
          "level": 0
        },
        {
          "text": "bypassPermissions: Skips all prompts (safe only)",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Switch with Shift+Tab",
          "bullet": true,
          "level": 0
        }
      ]
