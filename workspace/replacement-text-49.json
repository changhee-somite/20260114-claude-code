  "slide-31": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Three elements create security risk.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "1. Access to private data (env vars, credentials)",
          "bullet": true,
          "level": 0
        },
        {
          "text": "2. Exposure to untrusted content (web pages, user input)",
          "bullet": true,
          "level": 0
        },
        {
          "text": "3. External communication ability (network access)",
          "bullet": true,
          "level": 0
        },
        {
          "text": "AI cannot reliably detect prompt injection\u2014architecture must prevent it",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
