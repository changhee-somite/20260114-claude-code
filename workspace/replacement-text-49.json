  "slide-15": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Subagents spawn fresh context windows.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "Each subagent gets its own fresh context window",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Example: 36 files \u00f7 3 subagents = 12 files each",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Prevents main agent from sequential overload",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Enables parallel processing",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
