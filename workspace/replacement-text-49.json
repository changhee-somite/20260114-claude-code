  "slide-28": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Four permission modes are available.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "default: Prompts for first use of each tool",
          "bullet": true,
          "level": 0
        },
        {
          "text": "acceptEdits: Auto-accepts file edits for session",
          "bullet": true,
          "level": 0
        },
        {
          "text": "plan: Read-only analysis, no modifications",
          "bullet": true,
          "level": 0
        },
        {
          "text": "bypassPermissions: Skips all prompts (safe environment only)",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
  "slide-29": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Granular rules provide fine control.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "allow: [\"Bash(npm run test:*)\", \"Bash(git:*)\"]",
          "bullet": true,
          "level": 0
        },
        {
          "text": "deny: [\"Read(./.env)\", \"Read(**/*.key)\"]",
          "bullet": true,
          "level": 0
        },
        {
          "text": "ask: [\"Bash(git push:*)\", \"Bash(rm:*)\"]",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Evaluation order: deny \u2192 allow \u2192 ask",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
  "slide-30": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Hooks run scripts on tool events.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "PreToolUse: Run validation before tool executes",
          "bullet": true,
          "level": 0
        },
        {
          "text": "PostToolUse: Process results after tool completes",
          "bullet": true,
          "level": 0
        },
        {
          "text": "PermissionRequest: Custom permission logic",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Can block, modify, or auto-approve based on custom logic",
          "bullet": true,
          "level": 0
        }
      ]
    }
