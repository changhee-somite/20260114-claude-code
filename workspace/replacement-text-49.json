  "slide-11": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Section 2: Context Engineering",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "The fundamental constraint and how to work around it",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
  "slide-12": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "O(N\u00b2) complexity creates hard limits.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "Attention mechanism scales quadratically with sequence length",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Context window is a hard limit on what the model can \"see\"",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Everything the model knows about your task must fit in this window",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Wasted tokens = reduced capability",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
  "slide-13": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "Context engineering is the key skill.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "Minimal system prompts: <1,000 tokens vs competitors' 10,000+",
          "bullet": true,
          "level": 0
        },
        {
          "text": "File-based planning: External markdown preserves info across sessions",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Progressive disclosure: Load tool docs only when needed",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Pre-session artifacts: Research sessions \u2192 implementation sessions",
          "bullet": true,
          "level": 0
        }
      ]
    }
  },
  "slide-14": {
    "shape-0": {
      "paragraphs": [
        {
          "text": "/status monitors context in real-time.",
          "bold": true
        }
      ]
    },
    "shape-1": {
      "paragraphs": [
        {
          "text": "Current session: percentage of context window used",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Session reset: when the 5-hour window resets",
          "bullet": true,
          "level": 0
        },
        {
          "text": "Weekly usage across Opus and Sonnet models",
